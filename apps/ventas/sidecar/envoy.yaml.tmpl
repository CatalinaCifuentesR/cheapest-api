static_resources:
  listeners:
    - name: ventas_to_inventario
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 10000
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ventas_proxy
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: inventario
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: inventario_cluster
                            # TODO [1]: Calcule el timeout total de la ruta.
                            # Debe cubrir: (connect_timeout + upstream response) × (1 intento original + num_retries) + backoff acumulado.
                            # Un timeout demasiado corto aborta los reintentos; uno demasiado largo acumula conexiones en espera.
                            timeout: ???s
                            retry_policy:
                              retry_on: "5xx,reset,connect-failure,gateway-error"
                              # TODO [2]: ¿Cuántos reintentos son suficientes para cubrir fallos transitorios
                              # sin amplificar la carga más allá de 2× (ASR-2)?
                              num_retries: ???
                              retry_back_off:
                                # TODO [3]: Defina el intervalo base del backoff exponencial (en segundos, p. ej. 0.1s).
                                # Recuerde que Envoy aplica ±25 % de jitter automáticamente sobre este valor.
                                base_interval: ???s
                                # TODO [4]: Defina el intervalo máximo del backoff (en segundos).
                                # Evite valores tan altos que el timeout de la ruta expire antes del último reintento.
                                max_interval: ???s
                              retry_host_predicate:
                                - name: envoy.retry_host_predicates.previous_hosts
                                  typed_config:
                                    "@type": type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate
                              host_selection_retry_max_attempts: "3"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: inventario_cluster
      connect_timeout: 2s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      # Sin panic mode: cuando todos los hosts están eyectados (circuito OPEN), Envoy responde
      # 503 inmediato (flag UH) en lugar de seguir enviando tráfico al host caído.
      common_lb_config:
        healthy_panic_threshold:
          value: 0
      load_assignment:
        cluster_name: inventario_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      # Sustituido en tiempo de arranque por entrypoint.sh mediante envsubst.
                      # docker-compose → INVENTARIO_UPSTREAM_HOST=inventario, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (mismo task) → INVENTARIO_UPSTREAM_HOST=localhost, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (cross-task) → INVENTARIO_UPSTREAM_HOST=<ALB DNS>, INVENTARIO_UPSTREAM_PORT=80
                      address: ${INVENTARIO_UPSTREAM_HOST}
                      port_value: ${INVENTARIO_UPSTREAM_PORT}

      # Límites de recursos del proxy — evitan que el sidecar mismo se convierta en un cuello de botella.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 100
            max_pending_requests: 50
            max_requests: 100
            max_retries: 10

      # Outlier detection = implementación del patrón Circuit Breaker en Envoy.
      # Estados: CLOSED (normal) → OPEN (host eyectado) → HALF-OPEN (prueba automática).
      outlier_detection:
        # TODO [5]: ¿Cuántos errores 5xx consecutivos deben ocurrir para abrir el circuito?
        # Valor bajo → más sensible (abre rápido, más falsos positivos).
        # Valor alto → más tolerante (tarda más en proteger al servicio).
        consecutive_5xx: ???
        interval: 10s
        # TODO [6]: ¿Cuánto tiempo debe permanecer el circuito OPEN antes de intentar HALF-OPEN?
        # Debe ser inferior a la duración del fallo inyectado en Inventario (durationMs del
        # endpoint de caos) para que el estado HALF-OPEN pueda detectar la recuperación.
        base_ejection_time: ???s
        max_ejection_percent: 100
        enforcing_consecutive_5xx: 100
        enforcing_success_rate: 0
        split_external_local_origin_errors: false

admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 9901
