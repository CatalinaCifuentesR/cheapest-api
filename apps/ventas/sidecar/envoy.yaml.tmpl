static_resources:
  listeners:
    - name: ventas_to_inventario
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 10000
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ventas_proxy
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: inventario
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: inventario_cluster
                            # TODO [1]: Calcule el timeout total de la ruta.
                            # Debe cubrir: (connect_timeout + upstream response) Ã— (1 intento original + num_retries) + backoff acumulado.
                            # Un timeout demasiado corto aborta los reintentos; uno demasiado largo acumula conexiones en espera.
                            timeout: 2s
                            retry_policy:
                              retry_on: "5xx,reset,connect-failure,gateway-error"
                              # TODO [2]: Â¿CuÃ¡ntos reintentos son suficientes para cubrir fallos transitorios
                              # sin amplificar la carga mÃ¡s allÃ¡ de 2Ã— (ASR-2)?
                              num_retries: 1
                              retry_back_off:
                                # TODO [3]: Defina el intervalo base del backoff exponencial (en segundos, p. ej. 0.1s).
                                # Recuerde que Envoy aplica Â±25 % de jitter automÃ¡ticamente sobre este valor.
                                base_interval: 0.1s
                                # TODO [4]: Defina el intervalo mÃ¡ximo del backoff (en segundos).
                                # Evite valores tan altos que el timeout de la ruta expire antes del Ãºltimo reintento.
                                max_interval: 0.5s
                              retry_host_predicate:
                                - name: envoy.retry_host_predicates.previous_hosts
                                  typed_config:
                                    "@type": type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate
                              host_selection_retry_max_attempts: "3"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: inventario_cluster
      connect_timeout: 2s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      # Sin panic mode: cuando todos los hosts estÃ¡n eyectados (circuito OPEN), Envoy responde
      # 503 inmediato (flag UH) en lugar de seguir enviando trÃ¡fico al host caÃ­do.
      common_lb_config:
        healthy_panic_threshold:
          value: 0
      load_assignment:
        cluster_name: inventario_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      # Sustituido en tiempo de arranque por entrypoint.sh mediante envsubst.
                      # docker-compose â†’ INVENTARIO_UPSTREAM_HOST=inventario, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (mismo task) â†’ INVENTARIO_UPSTREAM_HOST=localhost, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (cross-task) â†’ INVENTARIO_UPSTREAM_HOST=<ALB DNS>, INVENTARIO_UPSTREAM_PORT=80
                      address: ${INVENTARIO_UPSTREAM_HOST}
                      port_value: ${INVENTARIO_UPSTREAM_PORT}

      # LÃ­mites de recursos del proxy â€” evitan que el sidecar mismo se convierta en un cuello de botella.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 100
            max_pending_requests: 50
            max_requests: 100
            max_retries: 10

      # Outlier detection = implementaciÃ³n del patrÃ³n Circuit Breaker en Envoy.
      # Estados: CLOSED (normal) â†’ OPEN (host eyectado) â†’ HALF-OPEN (prueba automÃ¡tica).
      outlier_detection:
        # TODO [5]: Â¿CuÃ¡ntos errores 5xx consecutivos deben ocurrir para abrir el circuito?
        # Valor bajo â†’ mÃ¡s sensible (abre rÃ¡pido, mÃ¡s falsos positivos).
        # Valor alto â†’ mÃ¡s tolerante (tarda mÃ¡s en proteger al servicio).
        consecutive_5xx: 5
        interval: 10s
        # TODO [6]: Â¿CuÃ¡nto tiempo debe permanecer el circuito OPEN antes de intentar HALF-OPEN?
        # Debe ser inferior a la duraciÃ³n del fallo inyectado en Inventario (durationMs del
        # endpoint de caos) para que el estado HALF-OPEN pueda detectar la recuperaciÃ³n.
        base_ejection_time: 5s
        max_ejection_percent: 100
        enforcing_consecutive_5xx: 100
        enforcing_success_rate: 0
        split_external_local_origin_errors: false

admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 9901
